<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rediger Bruker - OSS AS</title>
  <link rel="stylesheet" href="/style.css">
  <script src="https://use.fontawesome.com/releases/v5.7.1/js/all.js"></script>
</head>

<body>
  <header>
    <nav>
      <ul class="navlinks">
        <li><a href="/home"><i class="fas fa-home"></i> Heim</a></li>
        <li><a href="/profile"><i class="fas fa-user"></i> Min profil</a></li>
        <% if (admin) { %>
          <li><a href="/admin" class="active"><i class="fas fa-cogs"></i> Admin</a></li>
        <% } %>
        <li><a href="/logout"><i class="fas fa-sign-out-alt"></i> Logg ut</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <div class="form-container">
      <h1>Rediger Bruker</h1>
      <form action="/admin/edit/<%= user.id %>" method="POST">
        <label for="firstname">Fornavn:</label>
        <input type="text" id="firstname" name="firstname" value="<%= user.firstname %>" required>

        <label for="lastname">Etternavn:</label>
        <input type="text" id="lastname" name="lastname" value="<%= user.lastname %>" required>

        <label for="email">E-post:</label>
        <input type="email" id="email" name="email" value="<%= user.email %>" required>

        <label for="role">Rolle (0 = bruker, 1 = admin):</label>
        <input type="number" id="role" name="role" min="0" max="1" value="<%= user.role %>" required>

        <button type="submit">Lagre endringar</button>
        <a class="cancel-button" href="/admin">Avbryt</a>
      </form>
    </div>
  </main>
</body>
</html>
