<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Legg til spel</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="form-container">
    <h1>Legg til spel</h1>
    <form action="/add-game" method="POST">
      <label for="tittel">Tittel:</label>
      <input type="text" id="tittel" name="tittel" required>

      <label for="årstall">Årstall:</label>
      <input type="number" id="årstall" name="årstall" required>

      <label for="rating">Rating (0–10):</label>
      <input type="number" id="rating" name="rating" step="0.1" min="0" max="10" required>

      <label for="sjanger">Sjanger:</label>
      <input type="text" id="sjanger" name="sjanger" required>

      <label for="image_url">Bilde-URL:</label>
      <input type="url" id="image_url" name="image_url" required>

      <button type="submit">Legg til spel</button>
    </form>
    <a class="cancel-button" href="/home">Avbryt</a>
  </div>
</body>
</html>
